AIVO_USER=
AIVO_PASSWORD=
AIVO_X_TOKEN=
AIVO_TIMEOUT=30
AIVO_AUTH_ATTEMPTS=3
AIVO_AUTH_RETRY_DELAY=1
# Proxies corporativos usados en autenticación y envío.
AIVO_HTTP_PROXY=http://claro-proxy
# El proxy usa HTTP también para destinos HTTPS (túnel CONNECT).
AIVO_HTTPS_PROXY=http://claro-proxy
# Opcional: ruta del token en el JSON de /auth, por ejemplo Authorization.
# Prioriza el campo indicado y luego Authorization y alternativas conocidas.
# La búsqueda no distingue mayúsculas y minúsculas.
AIVO_AUTH_TOKEN_FIELD=
# Oracle: esquema con acceso al DB link, remedy_inc_fija y AIVO_WHATSAPP_LOG.
AIVO_ORACLE_USER=
AIVO_ORACLE_PASSWORD=
AIVO_ORACLE_DSN=
# Opcional con python-oracledb: carpeta Instant Client para modo thick.
AIVO_ORACLE_CLIENT_LIB_DIR=
