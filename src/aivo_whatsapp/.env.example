AIVO_USER=
AIVO_PASSWORD=
AIVO_X_TOKEN=
AIVO_TIMEOUT=30
# Proxies corporativos usados en autenticación y envío.
AIVO_HTTP_PROXY=http://claro-proxy
AIVO_HTTPS_PROXY=https://claro-proxy
# Opcional: ruta del token en el JSON de /auth, por ejemplo Authorization.
# Vacío: prioriza Authorization; admite también token, access_token,
# data.token y data.access_token por compatibilidad.
AIVO_AUTH_TOKEN_FIELD=
